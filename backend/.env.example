# Copy to .env and fill in your own values: cp .env.example .env

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# GitHub integration
GITHUB_TOKEN=
GITHUB_ORG_NAME=tickarus-demo-org
GITHUB_WEBHOOK_SECRET=

# LLM provider: anthropic, openai, or leave empty for a mock provider
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
