# Copy to .env.local and fill in your own values: cp .env.local.example .env.local

# Base URL of the deployed/cloud backend API
NEXT_PUBLIC_API_URL=
# Base URL of the local backend API
NEXT_PUBLIC_LOCALHOST_URL=http://localhost:8000
# true = call NEXT_PUBLIC_API_URL, false = call NEXT_PUBLIC_LOCALHOST_URL
NEXT_PUBLIC_USE_CLOUD_API=false
